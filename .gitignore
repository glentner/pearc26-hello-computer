# Build directory (all LaTeX artifacts go here)
build/

# Generated PDFs (release PDFs attached to GitHub releases, not committed)
*.pdf

# TAPS camera-ready upload package (regenerated via `make upload`)
pearc26-*.zip

# LaTeX auxiliary files (in case any end up at root)
*.aux
*.log
*.out
*.toc
*.lof
*.lot
*.fls
*.fdb_latexmk
*.synctex.gz
*.synctex(busy)

# BibTeX auxiliary files
*.bbl
*.blg
*.bcf
*.run.xml

# Editor backup files
*~
*.swp
*.swo

# macOS
.DS_Store

# Per-user harness overrides (the portable, shared allowlist is .agents/settings.json, tracked)
.agents/settings.local.json
.claude/settings.local.json

# Python bytecode (the factory's bin/ + tests/ are stdlib python3)
__pycache__/
*.pyc
